# Copia este archivo a .env y rellena tu clave (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo del agente. Opciones habituales:
#   claude-opus-4-8   -> el más capaz (por defecto)
#   claude-sonnet-5   -> gran calidad a menor coste
#   claude-haiku-4-5  -> tareas simples y muy baratas
AGENT_MODEL=claude-opus-4-8

# Cada cuántos segundos revisa la bandeja de tareas
AGENT_POLL_SECONDS=30

# Tokens máximos de salida por respuesta
AGENT_MAX_TOKENS=16000
