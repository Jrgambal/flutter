[Unit]
Description=Agente Claude 24/7
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Usa un usuario dedicado sin privilegios; no lo ejecutes como root.
User=claude-agent
WorkingDirectory=/opt/claude-agent
EnvironmentFile=/opt/claude-agent/.env
ExecStart=/opt/claude-agent/.venv/bin/python daemon.py
Restart=always
RestartSec=5
# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/claude-agent

[Install]
WantedBy=multi-user.target
